{
  "mcpServers": {
    "ccx": {
      "command": "/bin/sh",
      "args": ["./bin/ccx-mcp", "--host", "codex"],
      "cwd": ".",
      "env_vars": ["PATH", "HOME", "CODEX_HOME", "CLAUDE_CONFIG_DIR", "CCX_HOME"],
      "tool_timeout_sec": 300,
      "default_tools_approval_mode": "approve"
    }
  }
}
