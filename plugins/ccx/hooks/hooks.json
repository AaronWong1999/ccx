{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ccx-hook\"", "timeout": 30, "statusMessage": "ccx：同步另一边的进展" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_ccx_ccx__.*",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"ccx: syncing a session the user asked for\"}}'"
          }
        ]
      }
    ]
  }
}
